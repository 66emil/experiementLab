# Local defaults. Copy to .env to override; never commit secrets.
EXPERIMENTLAB_DATABASE_URL=sqlite:///./experimentlab.db
EXPERIMENTLAB_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
EXPERIMENTLAB_DATASET_STORAGE_PATH=./storage/datasets
EXPERIMENTLAB_MAX_CSV_BYTES=10485760
EXPERIMENTLAB_MAX_CSV_ROWS=100000
